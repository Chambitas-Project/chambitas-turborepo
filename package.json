{
  "name": "chambitas-monorepo",
  "private": true,
  "packageManager": "pnpm@8.15.5",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:gen": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > libs/shared-types/src/supabase.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@nestjs/config": "^4.0.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2"
  }
}