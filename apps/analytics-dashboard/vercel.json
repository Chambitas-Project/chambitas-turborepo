{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm build --filter @chambitas/analytics",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/.*).*)",
      "destination": "/index.html"
    }
  ]
}